# Rewritten live by control-api's pgcat pool-settings control (see PgcatService.SetPgcatPoolSettingsAsync).
# One primary + 2 streaming replicas (postgres-replica1/2), same trio for all three databases.

[general]
host = "0.0.0.0"
port = 6432
# Scraped by Prometheus's pgcat job for the PgcatClientsWaiting alert - see
# sandbox/infra/prometheus/prometheus.yml and alerts.yml.
enable_prometheus_exporter = true
prometheus_exporter_port = 9930
connect_timeout = 5000
idle_timeout = 30000
healthcheck_timeout = 1000
healthcheck_delay = 30000
shutdown_timeout = 5000
# See PgcatService.RenderPgcatToml's identical comment: a 200-VU/20-replica run showed transient
# Docker-DNS lookup failures against postgres-replica1/2 turning into ~20s stalls once pgcat banned
# the replica for the old ban_time=20 - shortened so a sub-second DNS blip doesn't cascade that far.
ban_time = 3
log_client_connections = false
log_client_disconnections = false
autoreload = 15000
worker_threads = 4
admin_username = "admin_user"
admin_password = "admin_pass"

[pools.users_db]
pool_mode = "transaction"
default_role = "primary"
query_parser_enabled = true
query_parser_read_write_splitting = true
primary_reads_enabled = true

[pools.users_db.users.0]
username = "postgres"
password = "postgres"
pool_size = 40
statement_timeout = 0

[pools.users_db.shards.0]
servers = [["postgres", 5432, "primary"], ["postgres-replica1", 5432, "replica"], ["postgres-replica2", 5432, "replica"]]
database = "users_db"

[pools.links_db]
pool_mode = "transaction"
default_role = "primary"
query_parser_enabled = true
query_parser_read_write_splitting = true
primary_reads_enabled = true

[pools.links_db.users.0]
username = "postgres"
password = "postgres"
pool_size = 40
statement_timeout = 0

[pools.links_db.shards.0]
servers = [["postgres", 5432, "primary"], ["postgres-replica1", 5432, "replica"], ["postgres-replica2", 5432, "replica"]]
database = "links_db"

[pools.clicks_db]
pool_mode = "transaction"
default_role = "primary"
query_parser_enabled = true
query_parser_read_write_splitting = true
primary_reads_enabled = true

[pools.clicks_db.users.0]
username = "postgres"
password = "postgres"
pool_size = 40
statement_timeout = 0

[pools.clicks_db.shards.0]
servers = [["postgres", 5432, "primary"], ["postgres-replica1", 5432, "replica"], ["postgres-replica2", 5432, "replica"]]
database = "clicks_db"

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Mirrors BottleneckThresholds.Default - override any of these to tune BottleneckAdvisor's
  // verdict without a code change. See RunSnapshot.ThresholdsUsed: whatever's in effect here gets
  // saved alongside each run's verdict, so a later comparison between two runs can tell whether a
  // different verdict came from different load or from different thresholds.
  "BottleneckThresholds": {
    "HighCpuPercent": 85,
    "HighMemoryPercent": 90,
    "SlowHopP95Ms": 300,
    "HighFailedRequestRate": 0.05
  }
}

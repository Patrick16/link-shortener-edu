<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Deliberately no OpenTelemetry.Instrumentation.AspNetCore here: it pulls in a dependency on
         the ASP.NET Core shared framework, which ShortenerService/TrafficService (built on the
         plain dotnet/runtime base image, not dotnet/aspnet) don't have at runtime. The three actual
         web APIs add it themselves — see their own .csproj and the extra lines after
         AddServiceDefaults() in their Program.cs. -->
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
  </ItemGroup>

</Project>

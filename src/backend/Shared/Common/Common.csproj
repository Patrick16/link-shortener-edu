<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Caching.Abstractions" />
		<!-- EntityCacheService's L1 (in-process) layer, ahead of the IDistributedCache (Redis) L2
		     above - no separate ".Abstractions" package exists for IMemoryCache, this one package
		     ships both the interface and the implementation. -->
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" />
		<!-- HybridEntityCacheService - the alternative, DI-swappable IEntityCacheService<T>
		     implementation built on the BCL's own coalescing/L1+L2 cache instead of hand-rolling it
		     (see EntityCacheService's own comments for what it hand-rolls). -->
		<PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
		<!-- FromKeyedServicesAttribute, used on EntityCacheService's/LinkCacheService's circuit-
		     breaker constructor parameter - abstractions only, no DI container implementation. -->
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="MongoDB.Bson" />
		<!-- ResiliencePipelines/ResilienceMetrics - the shared circuit-breaker builder used here
		     (EntityCacheService/Redis) and, via this project reference, by Infrastructure (gRPC,
		     RabbitMQ) too. -->
		<PackageReference Include="Polly.Core" />
		<PackageReference Include="UAParser" />
	</ItemGroup>

</Project>

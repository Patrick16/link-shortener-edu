# Backend service base URLs (behind the nginx load balancer in docker-compose)
VITE_AUTH_API_URL=http://localhost:8081
VITE_LINK_API_URL=http://localhost:8082
VITE_REDIRECT_API_URL=http://localhost:8083
# ReportingApi has no nginx in front of it yet (low-traffic, read-only) - direct container port.
VITE_REPORTING_API_URL=http://localhost:8088
